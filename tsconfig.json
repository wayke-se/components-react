{
  "compilerOptions": {
    "outDir": "dist",
    "module": "esNext",
    "target": "es2020",
    "sourceMap": true,
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
  }
}
