{
  "name": "@wayke-se/components-react",
  "version": "5.0.2",
  "description": "",
  "module": "dist/index.mjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "test": "npm run lint",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'example/**/*.{ts,tsx}' --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prettify": "prettier --write 'src/**/*.{ts,tsx}'",
    "gen": "graphql-codegen --config ./codegen.yml",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator src/utils/metadata.min.json --countries SE,NO --extended",
    "prepare": "husky",
    "start": "node ./esbuild/start.js",
    "build": "npm run clean && node ./esbuild/lib.js",
    "clean": "rimraf build && rimraf dist && rimraf dist-cdn",
    "build:types": "tsc --emitDeclarationOnly --declaration --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayke-se/components-react.git"
  },
  "author": "Ourstudio",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "styled-components": "^6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@types/googlemaps": "^3.43.3",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-slick": "^0.23.13",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@wayke-se/ecom-web": "^2.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "libphonenumber-metadata-generator": "^2.0.6",
    "lint-staged": "^17.0.7",
    "npm-dts": "^1.3.13",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "rimraf": "^6.1.3",
    "styled-components": "^6.4.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@emotion/is-prop-valid": "^1.4.0",
    "@photo-sphere-viewer/core": "^5.14.1",
    "date-fns": "^4.4.0",
    "graphql": "^16.14.2",
    "i18next": "^26.3.1",
    "libphonenumber-js": "^1.13.6",
    "marked": "^18.0.5",
    "react-compound-slider": "^3.4.0",
    "react-i18next": "^17.0.8",
    "react-slick": "^0.31.0",
    "scroll-into-view-if-needed": "^3.1.0"
  }
}
