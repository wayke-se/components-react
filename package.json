{
  "name": "@wayke-se/components-react",
  "version": "6.0.0",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "test": "npm run lint && npm run typecheck",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator src/utils/metadata.min.json --countries SE,NO --extended",
    "prepare": "husky",
    "start": "node ./esbuild/start.js",
    "build": "npm run clean && node ./esbuild/lib.js && node ./esbuild/cdn.js",
    "clean": "rimraf build && rimraf dist && rimraf dist-cdn",
    "build:types": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayke-se/components-react.git"
  },
  "author": "Ourstudio",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "styled-components": "^6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-slick": "^0.23.13",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "libphonenumber-metadata-generator": "^2.0.6",
    "lint-staged": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "rimraf": "^6.1.3",
    "styled-components": "^6.6.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@wayke-se/ecom-web": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.5.11",
    "libphonenumber-js": "^1.13.15",
    "marked": "^18.1.2",
    "react-compound-slider": "^3.4.0",
    "react-i18next": "^17.1.9",
    "react-slick": "^0.31.0",
    "scroll-into-view-if-needed": "^3.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  }
}
